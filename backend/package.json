{
  "name": "backend",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env.local src/index.ts",
    "start": "tsx --env-file-if-exists=../.env.local src/index.ts",
    "build": "prisma generate && tsc --noEmit",
    "db:migrate": "node --env-file-if-exists=../.env.local node_modules/prisma/build/index.js migrate deploy",
    "test": "node --env-file-if-exists=../.env.local test.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@hono/swagger-ui": "0.5.0",
    "@hono/zod-openapi": "^1.6.3",
    "@neon/realtime": "^0.2.0",
    "@prisma/client": "^6.7.0",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.6.1",
    "dotenv": "^16.4.7",
    "hono": "^4.7.5",
    "jose": "^6.2.15",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.14.0",
    "nodemailer": "^10.3.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^20.11.17",
    "@types/nodemailer": "^8.0.2",
    "prisma": "^6.8.1",
    "typescript": "^7.0.2"
  }
}
