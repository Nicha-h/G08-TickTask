# Example environment variables for backend

# App
NODE_ENV=development
PORT=3000
BACKEND_URL=
FRONTEND_URL=

# Neon (written to the repo root .env.local by `neon deploy` / `neon env pull`; the npm scripts load it)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
NEON_REALTIME_URL=
NEON_REALTIME_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Auth emails (password reset codes, verification) are sent by Neon Auth.
# Set the sender in Neon Console → Settings → Better Auth (custom SMTP); the app needs no email credentials.
